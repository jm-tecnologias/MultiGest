<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="498.0" prefWidth="1091.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mz.co.jmtecnologias.multigest.CompanyController">
   <children>
      <TableView fx:id="table" layoutX="20.0" layoutY="198.0" onMouseClicked="#selectedRow" prefHeight="248.0" prefWidth="1054.0">
         <columns>
            <TableColumn fx:id="idColumn" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Name" />
            <TableColumn fx:id="resonColumn" prefWidth="250.0" text="Reson" />
            <TableColumn fx:id="nuitColumn" prefWidth="150.0" text="Nuit" />
            <TableColumn fx:id="createdAtColumn" prefWidth="175.0" text="Created At" />
            <TableColumn fx:id="updatedATColumn" prefWidth="175.0" text="Updated At" />
            <TableColumn fx:id="deletedStatusColumn" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" text="Active" />
         </columns></TableView>
      <Label fx:id="statusLabel" layoutX="20.0" layoutY="458.0" prefHeight="17.0" prefWidth="1054.0" text="Label" />
      <HBox layoutX="510.0" layoutY="164.0" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#actionChecker" prefHeight="25.0" prefWidth="145.0" text="Save" />
            <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="145.0" text="Disactivate" />
            <Button mnemonicParsing="false" onAction="#resetField" prefHeight="25.0" prefWidth="145.0" text="Clear" />
         </children>
      </HBox>
      <TextArea fx:id="descriptionTextArea" layoutX="510.0" layoutY="47.0" prefHeight="98.0" prefWidth="475.0" promptText="Descripttion" />
      <HBox layoutX="20.0" layoutY="14.0" prefHeight="130.0" prefWidth="472.0">
         <children>
            <VBox prefHeight="130.0" prefWidth="63.0" spacing="20.0">
               <children>
                  <Label text="ID" />
                  <Label text="Name" />
                  <Label text="Reson" />
                  <Label text="NUIT" />
               </children>
            </VBox>
            <VBox prefHeight="130.0" prefWidth="409.0" spacing="10.0">
               <children>
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="idText" editable="false" prefHeight="25.0" prefWidth="121.0" />
                     </children>
                  </HBox>
                  <TextField fx:id="nameText" prefHeight="25.0" prefWidth="327.0" />
                  <TextField fx:id="resonText" prefHeight="25.0" prefWidth="327.0" />
                  <TextField fx:id="nuitText" prefHeight="25.0" prefWidth="327.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <TextField fx:id="searchText" layoutX="20.0" layoutY="164.0" prefHeight="25.0" prefWidth="472.0" />
   </children>
</AnchorPane>
